<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Car Dodge Game</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #111;
    color: white;
    font-family: Arial, sans-serif;
    text-align: center;
}

h1 {
    margin: 15px 0 5px;
}

#game {
    position: relative;
    width: 360px;
    height: 600px;
    margin: 15px auto;
    overflow: hidden;
    background: #333;
    border: 5px solid white;
}

/* Road */
#road {
    position: absolute;
    width: 100%;
    height: 100%;
    background: #444;
}

/* Road lines */
.line {
    position: absolute;
    width: 8px;
    height: 80px;
    background: white;
    left: 176px;
}

/* Player */
.car {
    position: absolute;
    width: 50px;
    height: 85px;
    border-radius: 10px;
}

#player {
    bottom: 20px;
    left: 155px;
    background: #2196f3;
}

/* Windows */
.car::before {
    content: "";
    position: absolute;
    width: 32px;
    height: 25px;
    background: #111;
    left: 9px;
    top: 10px;
    border-radius: 5px;
}

/* Enemy cars */
.enemy {
    background: #f44336;
}

/* Wheels */
.car::after {
    content: "⬛  ⬛";
    position: absolute;
    left: -7px;
    top: 30px;
    font-size: 16px;
    letter-spacing: 27px;
}

#score {
    font-size: 22px;
    margin: 10px;
}

#gameOver {
    display: none;
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.8);
    z-index: 10;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

#gameOver h2 {
    font-size: 40px;
    color: #ff4444;
}

button {
    padding: 12px 25px;
    font-size: 18px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    background: #2196f3;
    color: white;
}

button:hover {
    background: #1976d2;
}

.controls {
    margin-top: 10px;
}

.controlBtn {
    width: 80px;
    margin: 5px;
    font-size: 25px;
}
</style>
</head>

<body>

<h1>🚗 CAR DODGE</h1>

<div id="score">
    Score: <span id="scoreValue">0</span>
</div>

<div id="game">

    <div id="road"></div>

    <div id="player" class="car"></div>

    <div id="gameOver">
        <h2>GAME OVER</h2>
        <p>Your Score: <span id="finalScore">0</span></p>
        <button onclick="restartGame()">Play Again</button>
    </div>

</div>

<div class="controls">
    <button class="controlBtn" onclick="moveLeft()">⬅️</button>
    <button class="controlBtn" onclick="moveRight()">➡️</button>
</div>

<p>Use ← → or A / D to move</p>

<script>

const game = document.getElementById("game");
const player = document.getElementById("player");
const scoreValue = document.getElementById("scoreValue");
const gameOverScreen = document.getElementById("gameOver");
const finalScore = document.getElementById("finalScore");

let playerX = 155;
let score = 0;
let gameSpeed = 4;
let gameRunning = true;
let enemies = [];
let lines = [];

/* Create road lines */
for (let i = 0; i < 7; i++) {

    let line = document.createElement("div");

    line.classList.add("line");

    line.style.top = (i * 100) + "px";

    game.appendChild(line);

    lines.push(line);
}

/* Move player left */
function moveLeft() {

    if (!gameRunning) return;

    playerX -= 25;

    if (playerX < 5) {
        playerX = 5;
    }

    player.style.left = playerX + "px";
}

/* Move player right */
function moveRight() {

    if (!gameRunning) return;

    playerX += 25;

    if (playerX > 305) {
        playerX = 305;
    }

    player.style.left = playerX + "px";
}

/* Keyboard controls */
document.addEventListener("keydown", function(event) {

    if (event.key === "ArrowLeft" || event.key.toLowerCase() === "a") {
        moveLeft();
    }

    if (event.key === "ArrowRight" || event.key.toLowerCase() === "d") {
        moveRight();
    }

});

/* Create enemy */
function createEnemy() {

    if (!gameRunning) return;

    let enemy = document.createElement("div");

    enemy.classList.add("car", "enemy");

    let randomX = Math.floor(Math.random() * 305);

    enemy.style.left = randomX + "px";
    enemy.style.top = "-100px";

    game.appendChild(enemy);

    enemies.push(enemy);
}

/* Collision */
function collision(a, b) {

    let aRect = a.getBoundingClientRect();
    let bRect = b.getBoundingClientRect();

    return !(
        aRect.bottom < bRect.top ||
        aRect.top > bRect.bottom ||
        aRect.right < bRect.left ||
        aRect.left > bRect.right
    );
}

/* Game loop */
function gameLoop() {

    if (!gameRunning) return;

    /* Move road */
    lines.forEach(line => {

        let top = parseInt(line.style.top);

        top += gameSpeed;

        if (top > 600) {
            top = -80;
        }

        line.style.top = top + "px";
    });

    /* Move enemies */
    enemies.forEach((enemy, index) => {

        let top = parseInt(enemy.style.top);

        top += gameSpeed;

        enemy.style.top = top + "px";

        /* Collision check */
        if (collision(player, enemy)) {

            endGame();

        }

        /* Enemy passed player */
        if (top > 620) {

            enemy.remove();

            enemies.splice(index, 1);

            score++;

            scoreValue.textContent = score;

            /* Increase difficulty */
            if (score % 5 === 0) {
                gameSpeed += 0.5;
            }
        }

    });

    requestAnimationFrame(gameLoop);
}

/* Spawn enemies */
setInterval(function() {

    if (gameRunning) {
        createEnemy();
    }

}, 1200);

/* Game over */
function endGame() {

    gameRunning = false;

    finalScore.textContent = score;

    gameOverScreen.style.display = "flex";
}

/* Restart */
function restartGame() {

    enemies.forEach(enemy => enemy.remove());

    enemies = [];

    score = 0;

    gameSpeed = 4;

    playerX = 155;

    player.style.left = playerX + "px";

    scoreValue.textContent = "0";

    gameOverScreen.style.display = "none";

    gameRunning = true;

    gameLoop();
}

/* Start game */
gameLoop();

</script>

</body>
</html>
